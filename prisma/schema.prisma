// Mikando Chicken & Take Away — database schema
// Uses SQLite for a free, zero-config local database.
// NOTE: SQLite (a local file) does NOT persist on Vercel's serverless
// filesystem. For a live deployment with persistent data, switch the
// datasource `provider` to "postgresql" and point DATABASE_URL at a hosted
// Postgres (e.g. Neon) — the Dish model below stays exactly the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int // UGX
  description String   @default("")
  imageUrl    String?
  available   Boolean  @default(true)
  category    String   @default("Main") // Main, Drinks, Sides
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
