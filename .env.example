# Postgres connection (Supabase / Neon / any Postgres).
# Use the pooled connection string for DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (non-pooled) connection — used by Prisma for migrations. Optional; set for Supabase/Neon.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
# Optional in production; set to your deployed URL if needed.
# AUTH_URL="https://your-domain.com"

# UploadThing — get a token at https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="your-uploadthing-token"
